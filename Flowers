        "# Install scipy to load .mat files\n",
        "!pip install scipy\n",
        "import scipy.io as sio\n",
        "import numpy as np\n",
        "import tensorflow as tf\n",
        "\n",
        "# Load the labels from imagelabels.mat\n",
        "labels_mat_path = os.path.join(output_dir, 'imagelabels.mat')\n",
        "mat_contents = sio.loadmat(labels_mat_path)\n",
        "\n",
        "# The labels are 1-indexed in the .mat file, so we need to subtract 1\n",
        "labels = mat_contents['labels'][0] - 1\n",
        "\n",
        "# Read image filenames from files.txt\n",
        "with open(files_txt_path, 'r') as f:\n",
        "    filenames = [line.strip() for line in f.readlines()]\n",
        "\n",
        "# Create full image paths\n",
        "image_paths = [os.path.join(output_dir, 'jpg', f) for f in filenames]\n",
        "\n",
        "# Verify that the number of images matches the number of labels\n",
        "print(f\"Number of images found: {len(image_paths)}\")\n",
        "print(f\"Number of labels found: {len(labels)}\")\n",
        "\n",
        "# Create a mapping for class names if available, or just use indices\n",
        "# (Assuming CLASS_NAMES is already defined based on the model's output layer)\n",
        "CLASS_NAMES = ['Bluebell', 'Buttercup', 'Coltsfoot', 'Cowslip', 'Crocus',\n",
        "               'Daffodil', 'Daisy', 'Dandelion', 'Fritillary', 'Iris',\n",
        "               'LilyValley', 'Pansy', 'Snowdrop', 'Sunflower', 'Tigerlily',\n",
        "               'Tulip', 'Windflower']\n",
        "\n",
        "# Function to load and preprocess images\n",
        "def load_image(image_path, label):\n",
        "    img = tf.io.read_file(image_path)\n",
        "    img = tf.image.decode_jpeg(img, channels=3)\n",
        "    img = tf.image.resize(img, [img_height, img_width])\n",
        "    img = img / 255.0  # Normalize to [0,1]\n",
        "    return img, label\n",
        "\n",
        "# Create a TensorFlow dataset\n",
        "dataset = tf.data.Dataset.from_tensor_slices((image_paths, labels))\n",
        "dataset = dataset.map(load_image, num_parallel_calls=tf.data.AUTOTUNE)\n",
        "\n",
        "# Split into training and validation sets\n",
        "dataset_size = tf.data.experimental.cardinality(dataset).numpy()\n",
        "train_size = int(0.8 * dataset_size)\n",
        "val_size = int(0.2 * dataset_size)\n",
        "\n",
        "# Shuffle the dataset and then split\n",
        "dataset = dataset.shuffle(buffer_size=dataset_size, seed=123)\n",
        "\n",
        "train_ds = dataset.take(train_size)\n",
        "val_ds = dataset.skip(train_size).take(val_size)\n",
        "\n",
        "# Batch and prefetch the datasets\n",
        "train_ds = train_ds.batch(batch_size).prefetch(tf.data.AUTOTUNE)\n",
        "val_ds = val_ds.batch(batch_size).prefetch(tf.data.AUTOTUNE)\n",
        "\n",
        "print(f\"Created training dataset with {tf.data.experimental.cardinality(train_ds).numpy() * batch_size} samples.\")\n",
        "print(f\"Created validation dataset with {tf.data.experimental.cardinality(val_ds).numpy() * batch_size} samples.\")\n"
      ],
