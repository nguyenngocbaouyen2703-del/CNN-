        "import tarfile\n",
        "\n",
        "def download_and_extract_dataset(dataset_path, file_name, output_dir):\n",
        "    # Create the output directory if it doesn't exist\n",
        "    pathlib.Path(output_dir).mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "    # Construct the full path to the tgz file\n",
        "    tgz_path = tf.keras.utils.get_file(\n",
        "        fname=file_name,\n",
        "        origin=f\"https://www.robots.ox.ac.uk/~vgg/data/flowers/17/{file_name}\",\n",
        "        extract=False # We will extract manually\n",
        "    )\n",
        "\n",
        "    # Extract the tgz file\n",
        "    with tarfile.open(tgz_path, 'r:gz') as tar:\n",
        "        tar.extractall(path=output_dir)\n",
        "    print(f\"Dataset extracted to: {output_dir}\")\n",
        "\n",
        "# Assuming dataset_path, file_name, and output_dir are defined from kernel state\n",
        "download_and_extract_dataset(dataset_path, file_name, output_dir)"
      ],
