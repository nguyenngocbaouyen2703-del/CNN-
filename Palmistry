        "import cv2\n",
        "import numpy as np\n",
        "\n",
        "def preprocess_palm(image_path):\n",
        "    img = cv2.imread(image_path, 0) # Đọc ảnh xám\n",
        "    # Cân bằng histogram để làm nổi bật đường chỉ tay\n",
        "    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))\n",
        "    enhanced_img = clahe.apply(img)\n",
        "    # Áp dụng bộ lọc Gaussian để khử nhiễu\n",
        "    blurred = cv2.GaussianBlur(enhanced_img, (5,5), 0)\n",
        "    # Tách cạnh bằng Canny (giúp AI nhìn rõ hơn)\n",
        "    edges = cv2.Canny(blurred, 50, 150)\n",
        "    return edges"
      ]
