        "import tensorflow as tf\n",
        "from tensorflow.keras.applications import MobileNetV2\n",
        "from tensorflow.keras import layers, models\n",
        "\n",
        "# Cấu hình\n",
        "img_size = (224, 224)\n",
        "data_dir = 'palm_dataset' # Đường dẫn thư mục sau khi giải nén\n",
        "\n",
        "# Load dữ liệu (Colab tự động chia nhãn dựa theo tên thư mục)\n",
        "train_ds = tf.keras.utils.image_dataset_from_directory(\n",
        "    data_dir, validation_split=0.2, subset=\"training\", seed=123, image_size=img_size, batch_size=32)\n",
        "val_ds = tf.keras.utils.image_dataset_from_directory(\n",
        "    data_dir, validation_split=0.2, subset=\"validation\", seed=123, image_size=img_size, batch_size=32)\n",
        "\n",
        "# Xây dựng mô hình với MobileNetV2\n",
        "base_model = MobileNetV2(input_shape=(224, 224, 3), include_top=False, weights='imagenet')\n",
        "base_model.trainable = False # Đóng băng để giữ đặc trưng hình học\n",
        "\n",
        "model = models.Sequential([\n",
        "    layers.Rescaling(1./127.5, offset=-1),\n",
        "    base_model,\n",
        "    layers.GlobalAveragePooling2D(),\n",
        "    layers.Dense(128, activation='relu'),\n",
        "    layers.Dropout(0.3),\n",
        "    layers.Dense(len(train_ds.class_names), activation='softmax')\n",
        "])\n",
        "\n",
        "model.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])\n",
        "model.fit(train_ds, validation_data=val_ds, epochs=15)\n",
        "model.save('palm_model.h5')"
