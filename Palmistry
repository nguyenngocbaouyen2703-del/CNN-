        "import tensorflow as tf\n",
        "from tensorflow.keras.preprocessing import image\n",
        "import numpy as np\n",
        "import os\n",
        "\n",
        "# Load the trained model\n",
        "model = tf.keras.models.load_model('palm_model.h5')\n",
        "\n",
        "# To get class names for prediction, we need to re-create the dataset information\n",
        "# assuming data_dir and img_size are defined in a previous cell\n",
        "img_size = (224, 224)\n",
        "data_dir = 'palm_dataset'\n",
        "train_ds = tf.keras.utils.image_dataset_from_directory(\n",
        "    data_dir, validation_split=0.2, subset=\"training\", seed=123, image_size=img_size, batch_size=32)\n",
        "\n",
        "class_names = train_ds.class_names\n",
        "\n",
        "def predict_palm_from_path(file_path):\n",
        "    if not os.path.exists(file_path):\n",
        "        print(f\"Error: File not found at {file_path}\")\n",
        "        return\n",
        "\n",
        "    # Preprocess the image\n",
        "    img = image.load_img(file_path, target_size=(224, 224))\n",
        "    img_array = np.expand_dims(image.img_to_array(img) / 127.5 - 1, axis=0)\n",
        "\n",
        "    # Predict\n",
        "    preds = model.predict(img_array)\n",
        "    result = class_names[np.argmax(preds)]\n",
        "\n",
        "    # Display result\n",
        "    print(f\"Phân tích cho ảnh {file_path}: {result}\")\n",
        "\n",
        "# Example usage with a sample image from your dataset\n",
        "# You can change this path to any image in your 'palm_dataset'\n",
        "sample_image_path = 'palm_dataset/FEMALE/IMG_0001.JPG' # Example path\n",
        "predict_palm_from_path(sample_image_path)\n",
        "\n",
        "sample_image_path_male = 'palm_dataset/MALE/IMG_0001.JPG'\n",
        "predict_palm_from_path(sample_image_path_male)"
